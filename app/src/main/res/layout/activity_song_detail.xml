<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/gradient_bg_player">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/white"
                    android:padding="6dp"
                    android:background="@drawable/circle_shape"
                    android:contentDescription="@string/img"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>


                <ImageView
                    android:id="@+id/iv_fav"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_non_fav"
                    app:tint="@color/white"
                    android:background="@drawable/circle_shape"
                    android:padding="6dp"
                    android:contentDescription="@string/img"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
                >

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_song"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    app:shapeAppearanceOverlay="@style/Circle_ImageView"
                    tools:src="@tools:sample/avatars"
                    android:background="@drawable/circle_shape"
                    android:padding="10dp"
                    android:contentDescription="@string/img"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Title"
                    style="@style/SemiBoldStyle"
                    android:textSize="24sp"
                    android:singleLine="true"
                    android:layout_marginTop="6dp"
                    app:layout_constraintTop_toBottomOf="@id/iv_song"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tv_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Artist"
                    style="@style/RegularStyle"
                    android:textSize="18sp"
                    android:singleLine="true"
                    android:layout_marginTop="3dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tv_album"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Album"
                    style="@style/RegularStyle"
                    android:singleLine="true"
                    android:layout_marginTop="3dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_title"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="3:00"
                    style="@style/RegularStyle"
                    android:singleLine="true"
                    android:layout_marginTop="3dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_title"
                    app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/playback_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            app:layout_constraintVertical_bias="0.8"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/content_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_repeat"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_repeat"
                    app:tint="@color/white"
                    android:layout_marginEnd="30dp"
                    android:contentDescription="@string/img"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_play_previous"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_play_previous"
                    app:tint="@color/white"
                    android:layout_marginEnd="24dp"
                    android:contentDescription="@string/img"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_play"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_play_2"
                    app:tint="@color/white"
                    android:layout_marginEnd="24dp"
                    android:contentDescription="@string/img"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_play_next"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_play_next"
                    app:tint="@color/white"
                    android:layout_marginEnd="30dp"
                    android:contentDescription="@string/img"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_shuffle"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_shuffle"
                    app:tint="@color/white"
                    android:contentDescription="@string/img"/>

        </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>