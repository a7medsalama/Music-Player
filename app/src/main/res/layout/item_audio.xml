<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAudioItem"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/audio_item_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">


    <View
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/round_gray_shape"
        app:layout_constraintEnd_toEndOf="@id/imageArtwork"
        app:layout_constraintTop_toTopOf="@id/imageArtwork"
        app:layout_constraintBottom_toBottomOf="@id/imageArtwork"
        app:layout_constraintStart_toStartOf="@id/imageArtwork" />

    <ImageView
        android:id="@+id/imageArtwork"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/ic_music"
        android:contentDescription="@string/img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/RegularStyle"
        tools:text="song name"
        android:textSize="16sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/imageArtwork"
        app:layout_constraintStart_toEndOf="@id/imageArtwork"
        app:layout_constraintEnd_toStartOf="@id/textDuration"/>

    <TextView
        android:id="@+id/textSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/RegularStyle"
        tools:text="artist name"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="3dp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="@id/textTitle"
        app:layout_constraintEnd_toStartOf="@id/textDuration"/>

    <TextView
        android:id="@+id/textDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="3:00"
        style="@style/RegularStyle"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>